# =============================================================================
# Example Terraform Variables
# =============================================================================
# Copy this file to terraform.tfvars and update the values for your environment
# =============================================================================

# Application name (used as prefix for all resources)
app_name = "my-app"

# AWS region
aws_region = "us-east-1"

# ECR repository name (must already exist)
ecr_repository_name = "my-app"

# Tags applied to all resources
tags = {
  Project     = "my-app"
  Environment = "cicd"
  ManagedBy   = "terraform"
}

# =============================================================================
# DEV Environment (Simple Deploy - No Pipeline)
# =============================================================================

dev_ecs_cluster_name = "dev-cluster"
dev_ecs_service_name = "my-app-dev"

# =============================================================================
# Release Pipeline Environments (TEST → STAGING → PROD)
# =============================================================================

ecs_clusters = {
  test    = "test-cluster"
  staging = "staging-cluster"
  prod    = "prod-cluster"
}

ecs_services = {
  test    = "my-app-test"
  staging = "my-app-staging"
  prod    = "my-app-prod"
}

# =============================================================================
# ALB Listeners (for Blue/Green traffic shifting)
# =============================================================================

alb_listeners = {
  test    = "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener/app/test-alb/xxx/xxx"
  staging = "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener/app/staging-alb/xxx/xxx"
  prod    = "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener/app/prod-alb/xxx/xxx"
}

# =============================================================================
# Target Groups (Blue/Green pairs for each environment)
# =============================================================================

target_groups = {
  test_blue     = "my-app-test-blue"
  test_green    = "my-app-test-green"
  staging_blue  = "my-app-staging-blue"
  staging_green = "my-app-staging-green"
  prod_blue     = "my-app-prod-blue"
  prod_green    = "my-app-prod-green"
}

# =============================================================================
# Test Environment URLs (for running tests against deployed environments)
# =============================================================================

test_environment_url    = "https://test.my-app.example.com"
staging_environment_url = "https://staging.my-app.example.com"

# =============================================================================
# Approval Configuration
# =============================================================================

# SNS topic for approval notifications (Slack, email, etc.)
approval_sns_topic_arn = "arn:aws:sns:us-east-1:123456789012:cicd-approvals"

# Optional: IAM role that can approve production deployments
# prod_approvers_iam_role = "arn:aws:iam::123456789012:role/release-managers"
