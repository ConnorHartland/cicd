        <mxCell id="prod" value="Production&#xa;Environment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows between environments -->
        <mxCell id="a1" value="Manual Deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontStyle=2;fontSize=10;" edge="1" parent="1" source="dev" target="test">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Auto on PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontStyle=2;fontSize=10;" edge="1" parent="1" source="test" target="staging">
          <mxGeometry relative="1" as="geometry" />
