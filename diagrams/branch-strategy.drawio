        </mxCell>

        <!-- Feature Branch -->
        <mxCell id="feature" value="feature/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
